{
  "entities": {
    "Organisation": {
      "title": "Organisation",
      "description": "Scout group or rover crew registration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Member": {
      "title": "Member",
      "description": "Scout crew member profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "idCard": { "type": "string" },
        "dob": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "section": { "type": "string" },
        "crewId": { "type": "string" },
        "crewName": { "type": "string" },
        "councilRole": { "type": "string" },
        "investitureDate": { "type": "string" },
        "status": { "type": "string" },
        "term": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "permAddress": { "type": "string" },
        "currAddress": { "type": "string" },
        "emergencyContactName": { "type": "string" },
        "emergencyContactNumber": { "type": "string" },
        "attendanceUnexcused": { "type": "number" },
        "attendanceExcused": { "type": "number" }
      },
      "required": ["id", "name", "email", "status"]
    },
    "SubCrew": {
      "title": "SubCrew",
      "description": "Sub-crew / Patrol unit definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "leaderId": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "SyllabusRequirement": {
      "title": "SyllabusRequirement",
      "description": "Badge requirement standard item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "badgeName": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "MemberRequirementProgress": {
      "title": "MemberRequirementProgress",
      "description": "Member requirement progression mark",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "requirementId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "memberId", "requirementId", "status"]
    },
    "CrewEvent": {
      "title": "CrewEvent",
      "description": "Assembly or activity event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "crewId": { "type": "string" },
        "crewName": { "type": "string" },
        "location": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "description": { "type": "string" },
        "targetAudience": { "type": "string" },
        "isCompulsory": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "notificationSent": { "type": "boolean" }
      },
      "required": ["id", "title", "startDate"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Individual event attendance mark",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "memberId": { "type": "string" },
        "status": { "type": "string" },
        "exemptionReason": { "type": "string" },
        "markedAt": { "type": "string" },
        "markedBy": { "type": "string" }
      },
      "required": ["id", "eventId", "memberId", "status"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Portfolio notebook record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "aiPolished": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "memberId"]
    },
    "DisciplinaryIncident": {
      "title": "DisciplinaryIncident",
      "description": "Council disciplinary record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "incidentDate": { "type": "string" },
        "infractionCategory": { "type": "string" },
        "narrativeNotes": { "type": "string" },
        "actionTaken": { "type": "string" },
        "status": { "type": "string" },
        "loggedBy": { "type": "string" }
      },
      "required": ["id", "memberId", "actionTaken"]
    },
    "MeetingMinutes": {
      "title": "MeetingMinutes",
      "description": "Council meeting minutes record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "meetingNumber": { "type": "string" },
        "meetingType": { "type": "string" },
        "date": { "type": "string" },
        "chairperson": { "type": "string" },
        "secretary": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "date"]
    },
    "RoverOperatingPolicy": {
      "title": "RoverOperatingPolicy",
      "description": "Crew bylaws and operating policy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "PolicyAmendmentPoll": {
      "title": "PolicyAmendmentPoll",
      "description": "Policy amendment voting poll",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "FeeRequest": {
      "title": "FeeRequest",
      "description": "Dues and fees collection request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amountMvr": { "type": "number" }
      },
      "required": ["id", "title", "amountMvr"]
    },
    "CrewPaymentTransaction": {
      "title": "CrewPaymentTransaction",
      "description": "Fee payment receipt or verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "feeRequestId": { "type": "string" },
        "amountMvr": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "memberId", "amountMvr", "status"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "System action audit log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action"]
    },
    "PortalSettings": {
      "title": "PortalSettings",
      "description": "Global application configuration settings",
      "type": "object",
      "properties": {
        "activeTerm": { "type": "string" },
        "aiEnabled": { "type": "boolean" },
        "smsNotificationsEnabled": { "type": "boolean" },
        "emailNotificationsEnabled": { "type": "boolean" }
      }
    },
    "CouncilFlagRecord": {
      "title": "CouncilFlagRecord",
      "description": "Attendance low performance council flag record",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "flaggedAt": { "type": "string" },
        "flaggedBy": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["memberId", "status"]
    },
    "AIMemberQuestionLog": {
      "title": "AIMemberQuestionLog",
      "description": "Collected member question and response log for AI model training and quality control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "memberRole": { "type": "string" },
        "question": { "type": "string" },
        "response": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" },
        "qualityRating": { "type": "string" },
        "userFeedback": { "type": "string" },
        "adminReviewNotes": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "convertedToQAId": { "type": "string" },
        "responseLatencyMs": { "type": "number" },
        "source": { "type": "string" }
      },
      "required": ["id", "memberId", "question", "response", "timestamp"]
    }
  },
  "firestore": {
    "/organisations/{orgId}": {
      "schema": { "$ref": "#/entities/Organisation" },
      "description": "Collection of organisations"
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "Collection of crew members"
    },
    "/crews/{crewId}": {
      "schema": { "$ref": "#/entities/SubCrew" },
      "description": "Collection of sub-crews"
    },
    "/syllabus/{reqId}": {
      "schema": { "$ref": "#/entities/SyllabusRequirement" },
      "description": "Collection of syllabus requirements"
    },
    "/progress/{progressId}": {
      "schema": { "$ref": "#/entities/MemberRequirementProgress" },
      "description": "Collection of member badge requirement progress records"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CrewEvent" },
      "description": "Collection of crew events"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Collection of attendance records"
    },
    "/journals/{journalId}": {
      "schema": { "$ref": "#/entities/JournalEntry" },
      "description": "Collection of journal entries"
    },
    "/disciplinary/{incidentId}": {
      "schema": { "$ref": "#/entities/DisciplinaryIncident" },
      "description": "Collection of disciplinary incidents"
    },
    "/minutes/{minuteId}": {
      "schema": { "$ref": "#/entities/MeetingMinutes" },
      "description": "Collection of meeting minutes"
    },
    "/policy/{policyId}": {
      "schema": { "$ref": "#/entities/RoverOperatingPolicy" },
      "description": "Collection containing rover policy documents"
    },
    "/polls/{pollId}": {
      "schema": { "$ref": "#/entities/PolicyAmendmentPoll" },
      "description": "Collection of policy amendment polls"
    },
    "/fee_requests/{feeId}": {
      "schema": { "$ref": "#/entities/FeeRequest" },
      "description": "Collection of fee requests"
    },
    "/payment_transactions/{txId}": {
      "schema": { "$ref": "#/entities/CrewPaymentTransaction" },
      "description": "Collection of fee payment transactions"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Collection of system audit logs"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PortalSettings" },
      "description": "Global application configuration document"
    },
    "/attendance_flags/{flagId}": {
      "schema": { "$ref": "#/entities/CouncilFlagRecord" },
      "description": "Collection of low attendance council review flags"
    },
    "/ai_question_logs/{logId}": {
      "schema": { "$ref": "#/entities/AIMemberQuestionLog" },
      "description": "Collection of member asked questions and quality control logs"
    }
  }
}
